{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo build",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.js": {
      "includeFiles": "{mcp/index.json.gz,lib/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-challenge"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
